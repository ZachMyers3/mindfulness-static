---
/**
 * SiteFooter.astro
 * Reads `site.contact`, `site.hours`, `site.social`, and `site.footer`
 * to render a 3-column layout (§9.2 spec):
 *   1. Studio — tagline + address
 *   2. Visit  — hours, phone (tel:), email (mailto:)
 *   3. Connect — social links
 * Bottom row: legalLinks + © {year} {business.name}
 */
import { site } from '../lib/site';
import { withBase } from '../lib/url';

const { business, contact, hours, social, footer } = site;
const year = new Date().getFullYear();

function formatTime(t: string | null): string {
  if (!t) return '';
  const [h, m] = t.split(':').map(Number);
  const period = h >= 12 ? 'PM' : 'AM';
  const hr12 = h % 12 || 12;
  return m === 0 ? `${hr12} ${period}` : `${hr12}:${String(m).padStart(2, '0')} ${period}`;
}
---

<footer class="site-footer" role="contentinfo">
  <div class="site-footer__inner">
    <div class="site-footer__grid">
      {/* Column 1: Studio */}
      <div class="site-footer__col">
        <h2 class="site-footer__heading">{business.name}</h2>
        <p class="site-footer__tagline">{footer.tagline}</p>
        <address class="site-footer__address">
          {contact.address.street}<br />
          {contact.address.city}, {contact.address.region} {contact.address.postalCode}
        </address>
      </div>

      {/* Column 2: Visit */}
      <div class="site-footer__col">
        <h2 class="site-footer__heading">Visit</h2>
        <ul class="site-footer__hours">
          {hours.map((h) => (
            <li>
              <span class="site-footer__day">{h.day}</span>
              <span class="site-footer__time">
                {h.closed ? 'Closed' : `${formatTime(h.open)} – ${formatTime(h.close)}`}
              </span>
            </li>
          ))}
        </ul>
        <p class="site-footer__contact-links">
          <a href={`tel:${contact.phone.replace(/[^+\d]/g, '')}`}>{contact.phone}</a><br />
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </p>
      </div>

      {/* Column 3: Connect */}
      <div class="site-footer__col">
        <h2 class="site-footer__heading">Connect</h2>
        <ul class="site-footer__social">
          {social.map((s) => (
            <li>
              <a href={s.href} rel="noopener noreferrer" target="_blank">{s.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {/* Bottom row */}
    <div class="site-footer__bottom">
      <nav class="site-footer__legal" aria-label="Legal">
        {footer.legalLinks.map((link, i) => (
          <Fragment>
            {i > 0 && <span class="site-footer__legal-sep" aria-hidden="true">·</span>}
            <a href={withBase(link.href)}>{link.label}</a>
          </Fragment>
        ))}
      </nav>
      <p class="site-footer__copyright">© {year} {business.name}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-cream-950);
    color: var(--color-cream-300);
    padding: 2.5rem 0 1.5rem;
    margin-top: auto;
  }

  .site-footer__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .site-footer__grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 3rem;
    }
  }

  .site-footer__heading {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-cream-50);
    margin: 0 0 0.75rem;
  }

  .site-footer__tagline {
    margin: 0 0 0.5rem;
    font-style: italic;
    color: var(--color-cream-500);
  }

  .site-footer__address {
    font-style: normal;
    line-height: 1.5;
    color: var(--color-cream-500);
  }

  .site-footer__hours {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }

  .site-footer__hours li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.15rem 0;
    font-size: 0.9rem;
  }

  .site-footer__day {
    color: var(--color-cream-500);
  }

  .site-footer__time {
    color: var(--color-cream-300);
    text-align: right;
  }

  .site-footer__contact-links a {
    color: var(--color-cream-300);
    text-decoration: none;
  }

  .site-footer__contact-links a:hover {
    text-decoration: underline;
  }

  .site-footer__social {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__social a {
    color: var(--color-cream-300);
    text-decoration: none;
  }

  .site-footer__social a:hover {
    text-decoration: underline;
  }

  .site-footer__bottom {
    border-top: 1px solid var(--color-cream-800);
    margin-top: 2rem;
    padding-top: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  @media (min-width: 640px) {
    .site-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .site-footer__legal {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .site-footer__legal a {
    color: var(--color-cream-500);
    font-size: 0.85rem;
    text-decoration: none;
  }

  .site-footer__legal a:hover {
    text-decoration: underline;
    color: var(--color-cream-300);
  }

  .site-footer__legal-sep {
    color: var(--color-cream-700);
  }

  .site-footer__copyright {
    font-size: 0.85rem;
    color: var(--color-cream-500);
    margin: 0;
  }
</style>

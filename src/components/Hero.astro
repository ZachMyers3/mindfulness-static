---
/**
 * Hero.astro
 * Full-bleed hero band per design-doc §9.2:
 *   "Full-bleed image, brand name + tagline overlaid or set beside the
 *    image, single primary CTA. No carousel, no auto-rotating slides."
 *
 * Props:
 *   title     — H1 / brand heading (required)
 *   tagline   — short subtitle below the title (required)
 *   image?    — Astro ImageMetadata (preferred) or a public URL/path.
 *               Only used when `background` is 'image'.
 *   alt?      — alt text for the hero image (required — decorative use `alt=""`)
 *   ctaLabel? — optional CTA button label
 *   ctaHref?  — optional CTA button destination
 *   background — 'brand' paints the BrandAtmosphere field with ink text,
 *                'image' uses the full-bleed photo with a scrim and white
 *                text (default 'brand').
 *   class?    — optional additional class for the section
 *
 * Notes:
 *   - Imported images go through `astro:assets` Picture (AVIF/WebP + srcset)
 *     so the LCP image stays small on mobile Lighthouse runs.
 *   - `loading="eager"` + `fetchpriority="high"` keep the hero on the critical path.
 *   - The 'brand' variant ships no hero image at all, so there is no LCP
 *     image to optimise.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Button from './Button.astro';
import BrandName from './BrandName.astro';
import BrandAtmosphere from './BrandAtmosphere.astro';

interface Props {
  title: string;
  tagline: string;
  image?: ImageMetadata | string;
  alt?: string;
  ctaLabel?: string;
  ctaHref?: string;
  background?: 'brand' | 'image';
  class?: string;
}

const {
  title,
  tagline,
  image,
  alt,
  ctaLabel,
  ctaHref,
  background = 'brand',
  class: className,
} = Astro.props;
const hasCta = Boolean(ctaLabel && ctaHref);
const isBrand = background === 'brand' || !image;
const isAsset = typeof image !== 'string';
---

<section
  class:list={['hero', isBrand ? 'hero--brand' : 'hero--image', className]}
  aria-labelledby="hero-title"
>
  {isBrand ? (
    <BrandAtmosphere />
  ) : (
    <div class="hero__image-wrap">
      {isAsset ? (
        <Picture
          src={image!}
          formats={['avif', 'webp']}
          widths={[640, 960, 1280, 1920]}
          sizes="100vw"
          alt={alt ?? ''}
          class="hero__image"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      ) : (
        <img
          src={image as string}
          alt={alt ?? ''}
          class="hero__image"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      )}
    </div>
  )}

  <div class="hero__content">
    <h1 id="hero-title" class="hero__title"><BrandName name={title} /></h1>
    <p class="hero__tagline">{tagline}</p>
    {hasCta && (
      <div class="hero__cta">
        <Button href={ctaHref!} variant="primary">{ctaLabel!}</Button>
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    width: 100%;
    min-height: 320px;
    overflow: hidden;
  }

  .hero--image {
    background: #1a1a1a;
    color: #fff;
  }

  /* The atmosphere supplies the cream field, so the type flips to ink. */
  .hero--brand {
    color: var(--color-ink);
    border-bottom: 1px solid rgba(58, 114, 104, 0.14);
  }

  .hero__image-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /* Picture wraps the img — stretch both so object-fit covers the band. */
  .hero__image-wrap :global(picture) {
    position: absolute;
    inset: 0;
    display: block;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* A gentle scrim keeps the headline legible over any photo. */
  .hero__image-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.25) 0%,
      rgba(0, 0, 0, 0.45) 100%
    );
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    padding: 4rem 1.5rem 5rem;
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw + 1rem, 4rem);
    line-height: 1.05;
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
    max-width: 22ch;
    color: #fff;
  }

  .hero--brand .hero__title {
    color: var(--color-ink);
  }

  .hero__tagline {
    font-size: clamp(1.05rem, 1vw + 0.9rem, 1.5rem);
    line-height: 1.4;
    margin: 0 0 1.5rem;
    max-width: 32ch;
    color: #fffdf8;
    opacity: 0.95;
  }

  .hero--brand .hero__tagline {
    color: var(--color-cream-900);
    opacity: 1;
  }

  .hero__cta {
    margin-top: 1rem;
  }

  /* On narrow viewports give the content panel a solid backdrop so it
     stays legible when the scrim has less room. */
  @media (max-width: 767px) {
    .hero--image .hero__content {
      background: rgba(26, 26, 26, 0.55);
      padding: 2rem 1.25rem 2.5rem;
      margin: 1rem;
      border-radius: 8px;
    }

    .hero--brand .hero__content {
      padding: 2rem 1.25rem 2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero {
      transition: none;
    }
  }
</style>

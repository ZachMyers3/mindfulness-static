---
/**
 * Dev-only hero crop tool. Injected at /tools/hero-crop/ during `astro dev`
 * (see heroCropTool in astro.config.mjs). Not present in production builds.
 */
import { listHeroTargets } from './hero-fs';

const targets = listHeroTargets(process.cwd());
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Hero crop tool</title>
  </head>
  <body>
    <main class="tool">
      <header class="tool__header">
        <p class="tool__eyebrow">Dev only</p>
        <h1>Hero crop tool</h1>
        <p class="tool__lede">
          Crop a photo to the site frame, pick a page, and apply it as that page’s
          <strong>Hero Image</strong>. You can still download a JPEG if you want to
          upload it later in <a href="/_writenex">/_writenex</a>.
        </p>
      </header>

      <fieldset class="presets">
        <legend>Frame</legend>
        <label>
          <input type="radio" name="preset" value="home" checked />
          Pages <span>12:5 · 1920×800 · full-bleed</span>
        </label>
      </fieldset>

      <p class="hint" data-hint>
        Used on every site page. Height follows the headline, so 12:5 is a desktop target, not an exact match on every screen.
      </p>

      <label class="file">
        <span>Choose a JPG or PNG</span>
        <input id="file" type="file" accept="image/jpeg,image/png,image/webp" />
      </label>

      <div class="stage" hidden data-stage>
        <img id="source" alt="Image to crop" />
      </div>

      <label class="file">
        <span>Apply to page</span>
        <select id="target">
          <option value="">Choose a page</option>
          {targets.map((target) => (
            <option value={`${target.collection}:${target.slug}`}>
              {target.title} ({target.previewUrl})
            </option>
          ))}
        </select>
      </label>

      <label class="file">
        <span>Alt text (optional)</span>
        <input id="alt" type="text" maxlength="160" placeholder="Short description of the photo" />
      </label>

      <p class="actions">
        <button type="button" id="apply" disabled>Apply to page</button>
        <button type="button" id="download" class="button--ghost" disabled>Download JPEG</button>
      </p>
      <p class="status" data-status hidden></p>
    </main>

    <script>
      import Cropper from 'cropperjs';
      import 'cropperjs/dist/cropper.css';

      type PresetId = 'home' | 'inner';

      const PRESETS: Record<
        PresetId,
        { ratio: number; width: number; height: number; hint: string }
      > = {
        home: {
          ratio: 12 / 5,
          width: 1920,
          height: 800,
          hint: 'Used on every site page. Height follows the headline, so 12:5 is a desktop target, not an exact match on every screen.',
        },
        inner: {
          ratio: 12 / 5,
          width: 1920,
          height: 800,
          hint: 'Used on every site page. Height follows the headline, so 12:5 is a desktop target, not an exact match on every screen.',
        },
      };

      type Target = {
        collection: 'pages';
        slug: string;
        title: string;
        heroImage?: string;
        heroAlt?: string;
        previewUrl: string;
        preset: PresetId;
      };

      const fileInput = document.querySelector<HTMLInputElement>('#file');
      const image = document.querySelector<HTMLImageElement>('#source');
      const stage = document.querySelector<HTMLElement>('[data-stage]');
      const hint = document.querySelector<HTMLElement>('[data-hint]');
      const downloadBtn = document.querySelector<HTMLButtonElement>('#download');
      const applyBtn = document.querySelector<HTMLButtonElement>('#apply');
      const targetSelect = document.querySelector<HTMLSelectElement>('#target');
      const altInput = document.querySelector<HTMLInputElement>('#alt');
      const statusEl = document.querySelector<HTMLElement>('[data-status]');
      const presetInputs = document.querySelectorAll<HTMLInputElement>('input[name="preset"]');

      let cropper: Cropper | null = null;
      let objectUrl: string | null = null;
      let targets: Target[] = [];

      function setReady(ready: boolean) {
        if (downloadBtn) downloadBtn.disabled = !ready;
        if (applyBtn) applyBtn.disabled = !ready || !targetSelect?.value;
      }

      function setStatus(message: string, href?: string) {
        if (!statusEl) return;
        statusEl.hidden = false;
        statusEl.replaceChildren();
        statusEl.append(message);
        if (href) {
          statusEl.append(' ');
          const link = document.createElement('a');
          link.href = href;
          link.textContent = 'Open page';
          statusEl.append(link);
        }
      }

      function selectedTarget(): Target | undefined {
        const value = targetSelect?.value;
        if (!value) return undefined;
        const [collection, slug] = value.split(':');
        return targets.find((item) => item.collection === collection && item.slug === slug);
      }

      function selectPreset(id: PresetId) {
        const input = document.querySelector<HTMLInputElement>(`input[name="preset"][value="${id}"]`);
        if (input) {
          input.checked = true;
          applyPreset();
        }
      }

      function currentPreset(): PresetId {
        const checked = document.querySelector<HTMLInputElement>('input[name="preset"]:checked');
        return (checked?.value as PresetId) ?? 'home';
      }

      function applyPreset() {
        const preset = PRESETS[currentPreset()];
        if (hint) hint.textContent = preset.hint;
        cropper?.setAspectRatio(preset.ratio);
      }

      function bindCropper() {
        if (!image) return;
        cropper?.destroy();
        cropper = new Cropper(image, {
          aspectRatio: PRESETS[currentPreset()].ratio,
          viewMode: 1,
          autoCropArea: 1,
          background: false,
          responsive: true,
          restore: false,
        });
        setReady(true);
      }

      async function loadTargets() {
        if (!targetSelect) return;
        try {
          const res = await fetch('/tools/api/hero-targets/');
          if (!res.ok) throw new Error('Could not load pages');
          const data = (await res.json()) as { targets: Target[] };
          targets = data.targets;
          targetSelect.replaceChildren();
          const blank = document.createElement('option');
          blank.value = '';
          blank.textContent = 'Choose a page';
          targetSelect.append(blank);
          for (const target of targets) {
            const option = document.createElement('option');
            option.value = `${target.collection}:${target.slug}`;
            option.textContent = `${target.title} (${target.previewUrl})`;
            targetSelect.append(option);
          }
        } catch (error) {
          targetSelect.replaceChildren();
          const option = document.createElement('option');
          option.value = '';
          option.textContent = 'Could not refresh page list';
          targetSelect.append(option);
          setStatus(error instanceof Error ? error.message : 'Could not load pages');
        }
      }

      fileInput?.addEventListener('change', () => {
        const file = fileInput.files?.[0];
        if (!file || !image || !stage) return;

        if (objectUrl) URL.revokeObjectURL(objectUrl);
        objectUrl = URL.createObjectURL(file);
        cropper?.destroy();
        cropper = null;
        setReady(false);

        image.src = objectUrl;
        stage.hidden = false;
        if (image.complete) {
          bindCropper();
        } else {
          image.addEventListener('load', bindCropper, { once: true });
        }
      });

      presetInputs.forEach((input) => {
        input.addEventListener('change', applyPreset);
      });

      targetSelect?.addEventListener('change', () => {
        const target = selectedTarget();
        if (target) {
          selectPreset(target.preset);
          if (altInput && target.heroAlt && !altInput.value) {
            altInput.value = target.heroAlt;
          }
        }
        setReady(Boolean(cropper));
      });

      function croppedBlob(): Promise<Blob> {
        return new Promise((resolve, reject) => {
          if (!cropper) {
            reject(new Error('Nothing to crop'));
            return;
          }
          const id = currentPreset();
          const preset = PRESETS[id];
          const canvas = cropper.getCroppedCanvas({
            width: preset.width,
            height: preset.height,
            imageSmoothingEnabled: true,
            imageSmoothingQuality: 'high',
          });
          canvas.toBlob(
            (blob) => (blob ? resolve(blob) : reject(new Error('Could not export JPEG'))),
            'image/jpeg',
            0.85,
          );
        });
      }

      function blobToBase64(blob: Blob): Promise<string> {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => resolve(String(reader.result));
          reader.onerror = () => reject(reader.error);
          reader.readAsDataURL(blob);
        });
      }

      applyBtn?.addEventListener('click', async () => {
        const target = selectedTarget();
        if (!target || !applyBtn) return;
        applyBtn.disabled = true;
        setStatus('Saving…');
        try {
          const blob = await croppedBlob();
          const imageBase64 = await blobToBase64(blob);
          const res = await fetch('/tools/api/hero-apply/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              collection: target.collection,
              slug: target.slug,
              imageBase64,
              heroAlt: altInput?.value.trim() ?? '',
            }),
          });
          const data = (await res.json()) as { error?: string; previewUrl?: string; heroImage?: string };
          if (!res.ok) throw new Error(data.error ?? 'Apply failed');
          setStatus(`Saved ${data.heroImage}.`, data.previewUrl);
        } catch (error) {
          setStatus(error instanceof Error ? error.message : 'Apply failed');
        } finally {
          setReady(Boolean(cropper));
        }
      });

      void loadTargets();

      downloadBtn?.addEventListener('click', () => {
        if (!cropper) return;
        const id = currentPreset();
        const preset = PRESETS[id];
        const canvas = cropper.getCroppedCanvas({
          width: preset.width,
          height: preset.height,
          imageSmoothingEnabled: true,
          imageSmoothingQuality: 'high',
        });
        canvas.toBlob(
          (blob) => {
            if (!blob) return;
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = `hero-${id}-${preset.width}x${preset.height}.jpg`;
            link.click();
            URL.revokeObjectURL(url);
          },
          'image/jpeg',
          0.85,
        );
      });
    </script>

    <style>
      :root {
        color-scheme: light;
        --ink: #1a1a1a;
        --muted: #444;
        --sage: #3a7268;
        --sage-ink: #2d5a50;
        --cream: #fffdf8;
        --cream-200: #f4eedb;
        --line: #e5e0db;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background: var(--cream);
        color: var(--ink);
        font-family: Georgia, 'Times New Roman', serif;
        line-height: 1.5;
      }

      .tool {
        max-width: 56rem;
        margin: 0 auto;
        padding: 2.5rem 1.25rem 4rem;
      }

      .tool__eyebrow {
        margin: 0 0 0.35rem;
        font-family: system-ui, sans-serif;
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--sage);
      }

      h1 {
        margin: 0 0 0.75rem;
        font-size: clamp(1.75rem, 3vw + 1rem, 2.4rem);
        line-height: 1.15;
      }

      .tool__lede {
        margin: 0 0 1.75rem;
        color: var(--muted);
        max-width: 42ch;
      }

      .tool__lede a {
        color: var(--sage);
      }

      .presets {
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 0.9rem 1rem 1rem;
        margin: 0 0 0.75rem;
        display: grid;
        gap: 0.5rem;
      }

      .presets legend {
        font-family: system-ui, sans-serif;
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0 0.35rem;
      }

      .presets label {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        font-family: system-ui, sans-serif;
      }

      .presets span {
        color: var(--muted);
        font-size: 0.85rem;
      }

      .hint,
      .file {
        font-family: system-ui, sans-serif;
        font-size: 0.9rem;
        color: var(--muted);
      }

      .file {
        display: grid;
        gap: 0.4rem;
        margin: 1.25rem 0;
      }

      .file span {
        font-weight: 600;
        color: var(--ink);
      }

      .stage {
        margin: 0 0 1.25rem;
        background: var(--cream-200);
        border: 1px solid var(--line);
        border-radius: 8px;
        overflow: hidden;
        max-height: 28rem;
      }

      .stage img {
        display: block;
        max-width: 100%;
      }

      select,
      #alt {
        width: 100%;
        max-width: 28rem;
        font: inherit;
        font-family: system-ui, sans-serif;
        padding: 0.45rem 0.55rem;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: #fff;
        color: var(--ink);
      }

      .actions {
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .status {
        font-family: system-ui, sans-serif;
        font-size: 0.9rem;
        color: var(--muted);
        margin: 1rem 0 0;
      }

      .status a {
        color: var(--sage);
      }

      #apply,
      #download {
        appearance: none;
        border: 0;
        border-radius: 999px;
        background: var(--sage);
        color: #fff;
        font-family: system-ui, sans-serif;
        font-size: 1rem;
        font-weight: 600;
        padding: 0.7rem 1.2rem;
        cursor: pointer;
      }

      #download.button--ghost {
        background: transparent;
        color: var(--sage-ink);
        box-shadow: inset 0 0 0 1.5px var(--sage);
      }

      #apply:hover:not(:disabled),
      #apply:focus-visible:not(:disabled) {
        background: var(--sage-ink);
      }

      #download.button--ghost:hover:not(:disabled),
      #download.button--ghost:focus-visible:not(:disabled) {
        background: var(--cream-200);
      }

      #apply:disabled,
      #download:disabled {
        opacity: 0.45;
        cursor: not-allowed;
      }
    </style>
  </body>
</html>

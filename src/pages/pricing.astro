---
/**
 * src/pages/pricing.astro
 * Pricing page — loads the `pages/pricing` Markdown entry and renders it
 * inside BaseLayout. PricingCard and FaqAccordion components (items 27, 28)
 * will be slotted in once they land in the components batch; for now the
 * page faithfully renders the Markdown body so the route is live and
 * SEO-indexable.
 */
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = await getEntry('pages', 'pricing');
if (!entry) {
  throw new Error('pages/pricing entry not found in src/content/pages/pricing.md');
}
const { Content } = await render(entry);
const { title, description, noindex = true } = entry.data;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <article class="prose">
    <Content />
  </article>
</BaseLayout>

---
/**
 * src/pages/index.astro
 * Homepage — loads the `pages/home` Markdown entry and renders it inside
 * BaseLayout. The Hero / ServiceCard / CTA-strip blocks specified in
 * design-doc §9.1 will be slotted in once the components batch (items 22-28)
 * lands; for now the page faithfully renders the Markdown body so the
 * site is live.
 */
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = await getEntry('pages', 'home');
if (!entry) {
  throw new Error('pages/home entry not found in src/content/pages/home.md');
}
const { Content } = await render(entry);
const { title, description, noindex = true } = entry.data;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <section class="home-intro">
    <h1>{title}</h1>
    <p class="home-tagline">{description}</p>
  </section>
  <article class="home-body prose">
    <Content />
  </article>
</BaseLayout>
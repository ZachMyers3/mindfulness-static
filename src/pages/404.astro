---
/**
 * src/pages/404.astro
 * Friendly 404 page (design doc §9.3 — "Built-in Astro 404. Renders a
 * friendly message + 'Go home' button. No tracking of 404s in the initial
 * build."). Astro automatically routes every unmatched URL here at build
 * time, so dev + prod both get the same friendly page.
 *
 * `prerender = true` makes the page a static HTML file emitted as
 * 404.html, which static hosts (Netlify, Cloudflare Pages, GitHub Pages
 * with custom 404 handling) can serve for unmatched routes.
 */
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site';
import { withBase } from '../lib/url';

const siteName = site.business.name;
const siteTagline = site.business.tagline;
---

<BaseLayout title={`Page not found`} description={`The page you’re looking for can’t be found. Head back to ${siteName}’s homepage to continue.`} noindex={true}>
  <section class="not-found" aria-labelledby="not-found-heading">
    <p class="not-found__eyebrow" aria-hidden="true">404</p>
    <h1 id="not-found-heading" class="not-found__title">Page not found</h1>
    <p class="not-found__body">
      The page you’re looking for has either moved, been retired, or never
      existed in the first place. Take a breath — and pick a next step below.
    </p>
    {siteTagline && (
      <p class="not-found__site-line">{siteTagline} — {siteName}</p>
    )}
    <div class="not-found__actions">
      <a href={withBase('/')} class="not-found__cta not-found__cta--primary">Go home</a>
      <a href={withBase('/contact/')} class="not-found__cta not-found__cta--secondary">Get in touch</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    max-width: 640px;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
    text-align: center;
  }

  .not-found__eyebrow {
    font-size: 1rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary, #3a7268);
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .not-found__title {
    font-size: clamp(2rem, 4vw + 1rem, 3rem);
    line-height: 1.15;
    margin-bottom: 1rem;
    color: var(--color-ink, #1a1a1a);
    letter-spacing: -0.02em;
  }

  .not-found__body {
    font-size: 1.125rem;
    color: var(--color-ink-muted, #444);
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .not-found__site-line {
    font-size: 0.95rem;
    color: var(--color-ink-muted, #666);
    margin-bottom: 2rem;
    font-style: italic;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .not-found__cta {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    border: 2px solid transparent;
  }

  .not-found__cta--primary {
    background: var(--color-primary, #3a7268);
    color: #fff;
  }

  .not-found__cta--primary:hover {
    background: #2f5d54;
  }

  .not-found__cta--secondary {
    background: transparent;
    color: var(--color-primary, #3a7268);
    border-color: var(--color-primary, #3a7268);
  }

  .not-found__cta--secondary:hover {
    background: var(--color-primary, #3a7268);
    color: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found__cta {
      transition: none;
    }
  }
</style>
---
/**
 * src/pages/terms.astro
 * Terms page — loads the `pages/terms` Markdown entry and renders it
 * inside BaseLayout.
 */
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = await getEntry('pages', 'terms');
if (!entry) {
  throw new Error('pages/terms entry not found in src/content/pages/terms.md');
}
const { Content } = await render(entry);
const { title, description, noindex = true } = entry.data;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <article class="prose">
    <Content />
  </article>
</BaseLayout>
---
/**
 * src/pages/contact.astro
 * Contact page — loads the `pages/contact` Markdown entry and renders it
 * inside BaseLayout. Includes LocalBusiness JSON-LD (item-41).
 */
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import JsonLd from '../components/JsonLd.astro';
import { site } from '../lib/site';

const entry = await getEntry('pages', 'contact');
if (!entry) {
  throw new Error('pages/contact entry not found in src/content/pages/contact.md');
}
const { Content } = await render(entry);
const { title, description, noindex = false, heroImage, heroAlt } = entry.data;
const heroSrc = heroImage || undefined;

// Build LocalBusiness structured data from site.json
const localBusiness = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": site.business.name,
  "description": site.business.description,
  "telephone": site.contact.phone,
  "email": site.contact.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": site.contact.address.street,
    "addressLocality": site.contact.address.city,
    "addressRegion": site.contact.address.region,
    "postalCode": site.contact.address.postalCode,
    "addressCountry": site.contact.address.country,
  },
  "openingHoursSpecification": site.hours.flatMap((h) => {
    if (h.closed) return [];
    const slots = h.periods?.length
      ? h.periods
      : h.open && h.close
        ? [{ open: h.open, close: h.close }]
        : [];
    return slots.map((slot) => ({
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": h.day,
      "opens": slot.open,
      "closes": slot.close,
    }));
  }),
  "sameAs": site.social.map((s) => s.href),
};
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <JsonLd data={localBusiness} />
  <Hero
    title={title}
    tagline={description}
    image={heroSrc}
    alt={heroAlt}
    background={heroSrc ? 'image' : 'brand'}
  />
  <article class="prose">
    <Content />
  </article>
</BaseLayout>

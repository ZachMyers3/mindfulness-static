---
/**
 * src/pages/contact.astro
 * Contact page — loads the `pages/contact` Markdown entry and renders it
 * inside BaseLayout. The address block, hours table, and LocalBusiness
 * JSON-LD (items 41) will be slotted in once they land in the
 * seo-assets batch; for now the page faithfully renders the Markdown
 * body so the route is live and SEO-indexable.
 */
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = await getEntry('pages', 'contact');
if (!entry) {
  throw new Error('pages/contact entry not found in src/content/pages/contact.md');
}
const { Content } = await render(entry);
const { title, description, noindex = true } = entry.data;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <article class="prose">
    <Content />
  </article>
</BaseLayout>

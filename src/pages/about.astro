---
/**
 * src/pages/about.astro
 * About page — loads the `pages/about` Markdown entry and renders it
 * inside BaseLayout with a PageHeader (h1) above the body.
 */
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const entry = await getEntry('pages', 'about');
if (!entry) {
  throw new Error('pages/about entry not found in src/content/pages/about.md');
}
const { Content } = await render(entry);
const { title, description, noindex = false } = entry.data;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <PageHeader title={title} description={description} />
  <article class="prose">
    <Content />
  </article>
</BaseLayout>

---
/**
 * src/pages/about.astro
 * About page — loads the `pages/about` Markdown entry and renders it
 * inside BaseLayout. PageHeader / instructor cards specified in design-doc
 * §9.2 will be slotted in once the components batch (items 22-28) lands;
 * for now the page faithfully renders the Markdown body so the route is
 * live and SEO-indexable.
 */
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = await getEntry('pages', 'about');
if (!entry) {
  throw new Error('pages/about entry not found in src/content/pages/about.md');
}
const { Content } = await render(entry);
const { title, description, noindex = false } = entry.data;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <article class="prose">
    <Content />
  </article>
</BaseLayout>
